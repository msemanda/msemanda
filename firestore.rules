rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && request.auth.token.email == 'semandamoses91@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isClinicalStaff() {
      return hasRole('DOCTOR') || hasRole('NURSE') || hasRole('LAB_TECH') ||
             hasRole('RADIOLOGY_TECH') || hasRole('PHYSIOTHERAPIST') ||
             hasRole('DENTIST') || hasRole('DIETITIAN') || hasRole('EMERGENCY_STAFF') ||
             hasRole('PHARMACY') || hasRole('RECEPTIONIST');
    }

    function isReceptionist() {
      return hasRole('RECEPTIONIST');
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin() || isClinicalStaff();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Invitations ──────────────────────────────────────────────────────────
    // Document ID is the invitee's email address.
    // Receptionist can create patient invites only. Admin can create any invite.
    match /invites/{email} {
      allow read:   if true;
      allow create: if isAdmin() || (
        isReceptionist() &&
        request.resource.data.role == 'PATIENT'
      );
      allow update: if isAdmin() || isReceptionist() || (
        isAuth() &&
        request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt', 'uid'])
      );
      allow delete: if isAdmin() || isReceptionist();
    }

    // ── Patient admissions (walk-in tracking) ────────────────────────────────
    match /admissions/{admissionId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || isReceptionist();
    }

    // ── Sessions (telemetry) ─────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ── Bills / Finance ──────────────────────────────────────────────────────
    match /bills/{billId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('PHARMACY') || isReceptionist();
    }

    // ── Consultation fees ────────────────────────────────────────────────────
    match /consultationFees/{feeId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || isReceptionist();
    }

    // ── Diagnostics ──────────────────────────────────────────────────────────
    match /diagnostics/{diagId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('DOCTOR') || hasRole('LAB_TECH') || hasRole('RADIOLOGY_TECH');
    }

    // ── Appointments ─────────────────────────────────────────────────────────
    match /appointments/{apptId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('DOCTOR') || hasRole('NURSE') || isReceptionist();
    }

    // ── Lab orders ───────────────────────────────────────────────────────────
    match /labOrders/{orderId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('DOCTOR') || hasRole('LAB_TECH');
    }

    // ── Radiology orders ─────────────────────────────────────────────────────
    match /radiologyOrders/{orderId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('DOCTOR') || hasRole('RADIOLOGY_TECH');
    }

    // ── CPOE / Clinical orders ────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('DOCTOR') || hasRole('NURSE');
    }

    // ── OT schedules ─────────────────────────────────────────────────────────
    match /otSchedules/{scheduleId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('DOCTOR') || hasRole('NURSE');
    }

    // ── Blood bank ───────────────────────────────────────────────────────────
    match /bloodBank/{recordId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('LAB_TECH');
    }

    // ── Emergency cases ──────────────────────────────────────────────────────
    match /emergencyCases/{caseId} {
      allow read:  if isAuth();
      allow write: if isAdmin() || hasRole('EMERGENCY_STAFF') || hasRole('DOCTOR') || hasRole('NURSE');
    }
  }
}
